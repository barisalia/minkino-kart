{
  "name": "minkino-kartlar",
  "version": "0.1.0",
  "description": "Minkino Kartlar — okul öncesi eğitici kart oyunu",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "build:app": "tsc && vite build --mode uygulama",
    "cap:sync": "npm run build:app && cap sync",
    "ses:denetim": "vite-node scripts/ses-denetim.ts",
    "preview": "vite preview --host",
    "test": "vitest run",
    "e2e": "playwright test",
    "gorsel": "node scripts/gorsel-indir.mjs",
    "film:mp4": "vite build && node scripts/film/mp4.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barisalia/minkino-kart.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/barisalia/minkino-kart/issues"
  },
  "homepage": "https://github.com/barisalia/minkino-kart#readme",
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.4",
    "svg-path-bbox": "^2.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/fredoka": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.7.0"
  },
  "private": true,
  "type": "module"
